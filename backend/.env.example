# Copy to .env for local development. .env is gitignored; never commit real values.
# In production these are set as environment variables on the host, not read from a file.

# HERE API key for routing and geocoding (create a project at https://platform.here.com).
HERE_API_KEY=

# Redis connection for the cache. Leave empty to use in-process memory (fine locally).
# Upstash (TLS) shape: rediss://default:<password>@<host>:6379
REDIS_URL=

# Set to true only while debugging locally. Never true in production.
DJANGO_DEBUG=false

# Signing key. Nothing is signed today, but set a long random value in production.
# Empty falls back to an insecure development key.
DJANGO_SECRET_KEY=

# Comma-separated hostnames the API will answer to (the deployed hostname in production).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Python logging level for the root logger: DEBUG, INFO, WARNING or ERROR.
DJANGO_LOG_LEVEL=INFO
